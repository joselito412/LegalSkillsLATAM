---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { SITE } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contribute">
  <div class="container">
    <div class="callout">
      <p class="eyebrow">📢 {t('callout.eyebrow')}</p>
      <h2>{t('callout.title')}</h2>
      <p class="body">{t('callout.body')}</p>
      <a class="btn btn-primary" href={SITE.githubUrl} target="_blank" rel="noopener">
        {t('callout.cta')} ↗
      </a>
    </div>
  </div>
</section>

<style>
  .callout {
    border: 1px solid rgba(88, 166, 255, 0.35);
    border-radius: var(--radius);
    background:
      radial-gradient(600px 200px at 100% 0%, rgba(88, 166, 255, 0.12), transparent 70%),
      var(--surface);
    padding: 44px;
    text-align: center;
  }
  .callout .eyebrow { color: var(--accent); }
  .body {
    color: var(--text-muted);
    max-width: 60ch;
    margin: 12px auto 26px;
    font-size: 1.02rem;
  }
</style>
