---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="pillars">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t('pillars.eyebrow')}</p>
      <h2>{t('pillars.title')}</h2>
    </div>

    <div class="grid grid-2 split">
      <article class="pillar fe">
        <div class="tag mono">Frontend · 0–50 pts</div>
        <h3>{t('pillars.fe_title')}</h3>
        <p class="sub">{t('pillars.fe_sub')}</p>
        <p class="scope">{t('pillars.fe_scope')}</p>
        <p class="owner mono">{t('pillars.fe_owner')}</p>
      </article>
      <article class="pillar be">
        <div class="tag mono">Backend · 0–50 pts</div>
        <h3>{t('pillars.be_title')}</h3>
        <p class="sub">{t('pillars.be_sub')}</p>
        <p class="scope">{t('pillars.be_scope')}</p>
        <p class="owner mono">{t('pillars.be_owner')}</p>
      </article>
    </div>

    <p class="rule mono">↳ {t('pillars.rule')}</p>
  </div>
</section>

<style>
  .split { gap: 22px; }
  .pillar {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px;
    background: var(--surface);
  }
  .pillar.fe { border-top: 3px solid var(--accent); }
  .pillar.be { border-top: 3px solid var(--risk-low); }
  .tag {
    display: inline-block;
    font-size: 0.74rem;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .pillar.fe .tag { color: var(--accent); }
  .pillar.be .tag { color: var(--risk-low-bright); }
  .sub { color: var(--text); font-weight: 600; margin: 0 0 10px; }
  .scope { color: var(--text-muted); margin: 0 0 14px; }
  .owner { color: var(--text-faint); font-size: 0.82rem; margin: 0; }
  .rule {
    text-align: center;
    color: var(--text-muted);
    margin-top: 26px;
    font-size: 0.95rem;
  }
</style>
